# ---------------------------------------------------------------------------
# Configuration de production — hébergement alwaysdata
# Copier en .env sur le serveur, puis remplacer COMPTE et les mots de passe.
# ---------------------------------------------------------------------------
APP_NAME="SaLMeTE 2026"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://COMPTE.alwaysdata.net

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Porto-Novo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Compte administrateur créé au premier « db:seed » (choisir un mot de passe fort)
ADMIN_EMAIL=admin@salmete.bj
ADMIN_PASSWORD=

# Base MySQL créée dans l'interface alwaysdata (Bases de données > MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql-COMPTE.alwaysdata.net
DB_PORT=3306
DB_DATABASE=COMPTE_salmete
DB_USERNAME=COMPTE
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="heviefoadrien@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
